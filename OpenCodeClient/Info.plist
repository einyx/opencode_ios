<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.grapeot.OpenCodeClient.session</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>opencode</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>OpenCode uses the camera to scan the pairing QR code that `opencode pair` prints, so this device can connect to your server.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>OpenCode connects to the OpenCode server you add, including one running on your own local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>OpenCode records your voice when you dictate a message in the chat, or when you talk to the assistant in Ambient mode.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
